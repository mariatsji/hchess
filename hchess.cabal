cabal-version:      3.4

-- This file has been generated from package.yaml by hpack version 0.34.4.
--
-- see: https://github.com/sol/hpack

name:               hchess
version:            0.1.0.0
category:           App
homepage:           https://github.com/mariatsji/hchess#readme
bug-reports:        https://github.com/mariatsji/hchess/issues
author:             Sjur Millidahl
maintainer:         sjur.millidahl@gmail.com
copyright:          2022 Sjur Millidahl
license-file:       LICENSE
build-type:         Simple
extra-source-files: README.md

source-repository head
  type:     git
  location: https://github.com/mariatsji/hchess

library
  ghc-options:        -Wall
  exposed-modules:
    AI
    AppContext
    Board
    Chess
    Evaluation
    GameLoop
    Move
    PGN
    Position
    Printer
    Style
    Tree

  hs-source-dirs:     src
  default-extensions:
    BlockArguments
    DeriveAnyClass
    DeriveGeneric
    DerivingVia
    NoImplicitPrelude
    NumericUnderscores
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    TupleSections

  build-depends:
    , aeson
    , ansi-terminal
    , attoparsec
    , base                >=4.7     && <5
    , bytestring
    , containers
    , deepseq
    , neat-interpolation
    , parallel
    , relude              >=1.2.0.0
    , text
    , time
    , transformers
    , utf8-string

  default-language:   GHC2024

executable hchess-profiled
  main-is:            Main.hs
  ghc-options:        -O2 -threaded -rtsopts -with-rtsopts=-N4
  hs-source-dirs:     profiled
  default-extensions:
    BlockArguments
    DeriveGeneric
    DerivingVia
    NoImplicitPrelude
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    TupleSections

  build-depends:
    , base                >=4.7     && <5
    , hchess
    , neat-interpolation
    , relude              >=1.2.0.0
    , text

  default-language:   GHC2024

executable hchess
  main-is:            Main.hs
  ghc-options:        -O2 -Wall -threaded -rtsopts -with-rtsopts=-N4
  hs-source-dirs:     app
  default-extensions:
    BlockArguments
    DeriveGeneric
    DerivingVia
    NoImplicitPrelude
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    TupleSections

  build-depends:
    , ansi-terminal
    , attoparsec
    , base           >=4.7     && <5
    , hchess
    , relude         >=1.2.0.0
    , text
    , transformers

  default-language:   GHC2024

test-suite hchess-test
  type:               exitcode-stdio-1.0
  ghc-options:        -W
  main-is:            Main.hs
  other-modules:
    AISpec
    MoveSpec
    PGNSpec

  hs-source-dirs:     test
  default-extensions:
    BlockArguments
    DeriveGeneric
    DerivingVia
    NoImplicitPrelude
    OverloadedStrings
    QuasiQuotes
    RecordWildCards
    TupleSections

  build-depends:
    , base                >=4.7     && <5
    , hchess
    , hspec
    , neat-interpolation
    , relude              >=1.2.0.0
    , text

  default-language:   GHC2024
